# Backend Configuration
DATABASE_URL=sqlite:///./data/legal_reasoning.db
PYTHONUNBUFFERED=1

# Optional: LLM API Keys (for enhanced reasoning)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# HTTPS Configuration (Let's Encrypt)
# Replace with your actual domain name
DOMAIN_NAME=example.com

# Email for Let's Encrypt notifications (certificate expiry, etc.)
LETSENCRYPT_EMAIL=admin@example.com

# Certbot environment: 'staging' for testing, 'production' for real certificates
# Use staging first to avoid rate limits (5 certificates per week)
CERTBOT_ENV=staging
